{
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git show *)",
      "Bash(git switch *)"
    ],
    "deny": [
      "Bash(az *)",
      "Bash(pwsh *)",
      "Bash(powershell.exe *)"
    ]
  },
  "autoMemoryEnabled": false,
  "model": "opus",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{REPO}}/cc.py\" check --daily --quiet --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
