{
  "permissions": {
    "allow": [
      "Read",
      "Edit(**)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(nl *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(cd *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(column *)",
      "Bash(diff *)",
      "Bash(comm *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(xargs wc *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git show *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git rm *)"
    ],
    "deny": [
      "Bash(az *)",
      "Bash(pwsh *)",
      "Bash(powershell.exe *)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.npmrc)",
      "Read(~/.claude/.credentials.json)",
      "Bash(cmdkey *)"
    ]
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Gmail" },
    { "serverName": "claude.ai Google Calendar" },
    { "serverName": "claude.ai Google Drive" }
  ],
  "autoMemoryEnabled": false,
  "skillOverrides": {
    "unslop": "user-invocable-only"
  },
  "attribution": {
    "commit": ""
  },
  "model": "claude-opus-5-5",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5"
  },
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Trusted repo: the user's private notes vault, the git repository at ~/vault (or $VAULT_DIR), and its configured origin remote on a private self-hosted server."
    ],
    "allow": [
      "$defaults",
      "Vault sync: from any working directory, Claude may commit to the vault repo at ~/vault (or $VAULT_DIR), push it to its origin remote, and git rm its daily notes after the weekly journal is committed."
    ],
    "soft_deny": [
      "$defaults",
      "Vault privacy: content from the vault at ~/vault must not enter any other repository, commit message, issue, PR, gist or public surface unless the user names the content and the destination."
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{UV}}\" run --script \"{{REPO}}/cc.py\" check --daily --quiet --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
