  "autoMemoryEnabled": false,
  "skillOverrides": {
    "unslop": "user-invocable-only"
  },
  "attribution": {
    "commit": ""
  },
  "model": "claude-opus-5-5",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5"
  },
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{UV}}\" run --script \"{{REPO}}/cc.py\" check --daily --quiet --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
